# Configuración de entorno (nunca commitear el .env real)
# Los valores reales viven en Google Secret Manager y se inyectan como
# variables de entorno en Cloud Run (PRD §10).

# Entorno: dev | staging | prod
ENV=dev

# Base de datos PostgreSQL de Supabase (PRD §4)
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase Auth — para verificar los JWT en cada petición (PRD §9)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<jwt-secret-del-proyecto-supabase>

# Redis (cola Celery — Upstash gratis en el MVP, PRD §11)
REDIS_URL=redis://default:<password>@<host>:<port>

# Gmail API / Google Cloud Pub/Sub (PRD §Épica 2)
GOOGLE_PUBSUB_VERIFICATION_TOKEN=<token-de-verificacion-del-topico>
GOOGLE_APPLICATION_CREDENTIALS_JSON=<service-account-json>
# Topic y suscripción de Pub/Sub
PUBSUB_TOPIC=gmail-notifications
PUBSUB_SUBSCRIPTION=gmail-notifications-sub

# Motor de IA JEV (PRD §4)
JEV_API_KEY=<jev-api-key>
JEV_BASE_URL=https://api.jev.example

# Cifrado AES-256-GCM del google_refresh_token (PRD §F1.3).
# 32 bytes en base64. En producción SOLO en Secret Manager.
TOKEN_ENCRYPTION_KEY=<base64-32-bytes>

# Monitoreo (PRD §4)
SENTRY_DSN=<sentry-dsn>

# API web
API_PORT=8000
